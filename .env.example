# ========================================================
# 1. ЛОКАЛЬНЫЙ ЗАПУСК (Local Development)
# Скопируйте этот файл в .env: cp .env.example .env
# ========================================================

# Порт локального веб-сервера
PORT=3000

# URL приложения (для ссылок в QR-кодах и cookie)
APP_URL=http://localhost:3000

# Локальная база данных PostgreSQL
SQL_HOST=localhost
SQL_PORT=5432
SQL_DB_NAME=inventory
SQL_USER=postgres
SQL_PASSWORD=postgres

# Секретный ключ для подписи JWT-токенов
JWT_SECRET=super-secret-jwt-key-university-inventory-2026

# Опционально: API ключ Gemini (если требуются AI-функции)
# GEMINI_API_KEY=your_key_here

# ========================================================
# 2. ДЕПЛОЙ НА NETLIFY (Environment Variables в панели Netlify)
# Задаются в Netlify -> Site configuration -> Environment variables
# ========================================================
#
# 1) DATABASE_URL:
# Строка подключения к облачной PostgreSQL (например, бесплатный Neon.tech или Supabase):
# postgresql://user:password@ep-cool-sample.eu-central-1.aws.neon.tech/neondb?sslmode=require
#
# 2) APP_URL:
# Адрес вашего сайта на Netlify (например: https://my-inventory.netlify.app)
# Нужен для генерации рабочих QR-ссылок и защищённых Cookie.
#
# 3) JWT_SECRET:
# Секретный длинный ключ (любая случайная строка из 32+ символов) для подписи токенов.
#
# 4) NODE_ENV:
# production
#
# Примечание: Переменная PORT на Netlify НЕ нужна (Netlify Functions работают через Serverless).
