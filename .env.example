# ========================================================
# 1. ЛОКАЛЬНЫЙ ЗАПУСК (Local Development)
# Скопируйте этот файл в .env: cp .env.example .env
# ========================================================

# Порт локального веб-сервера
PORT=3000

# URL приложения (для ссылок в QR-кодах и cookie)
APP_URL=http://localhost:3000

# Локальная база данных PostgreSQL
SQL_HOST=localhost
SQL_PORT=5432
SQL_DB_NAME=inventory
SQL_USER=postgres
SQL_PASSWORD=postgres

# Секретный ключ для подписи JWT-токенов
JWT_SECRET=super-secret-jwt-key-university-inventory-2026

# Опционально: API ключ Gemini (если требуются AI-функции)
# GEMINI_API_KEY=your_key_here

# ========================================================
# 2. ДЕПЛОЙ НА RENDER (Environment Variables в панели Render)
# Задаются в Render -> Ваш Web Service -> Environment
# ========================================================
#
# 1) DATABASE_URL:
# Строка подключения к PostgreSQL (например, из Neon.tech или Render PostgreSQL):
# postgresql://user:password@ep-cool-sample.eu-central-1.aws.neon.tech/neondb?sslmode=require
#
# 2) APP_URL:
# Публичный адрес вашего сервиса на Render (например: https://university-inventory.onrender.com)
#
# 3) JWT_SECRET:
# Секретная строка для шифрования токенов входа (32+ символа).
#
# 4) NODE_ENV:
# production
